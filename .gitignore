# Ignore everything
*

# But exclude these specific file types
!*.py
!*.pdf
!*.md
!*.txt
!*.pth
!*.JPG
!*.log

# Allow specific directories and their contents
!agentic_cascade_system/
!agentic_cascade_system/**
!checkpoints/
!checkpoints/**
!images/
!images/**
!cascade_prediction/
!cascade_prediction/**
!test/
!specs/
!specs/**
!azureml/
!azureml/**
!archive/
!videos/
!videos/**
!video.mp4
!wildfire.mp4
!best-yolov8n-finetuned.pt
!best-yolov8n-50epochs.pt
# And exclude the .gitignore file itself
!.gitignore
# Allow git configuration files
!.gitattributes
!*.drawio

# Ignore Python cache directories (even in allowed directories)
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.Python
**/*.so
**/*.egg
**/*.egg-info/
**/dist/
**/build/

# MLOps (Stage 1): model binaries are versioned in the MLflow / Azure ML model
# registry, not in git. Keep the small run summaries (curves png, history json).
#checkpoints/*.pth
# Local MLflow file store and Azure ML CLI scratch
#mlruns/
#mlflow.db
#.azureml/
#outputs/